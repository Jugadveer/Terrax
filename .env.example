# Copy to .env and fill in. Every value below has a working default,
# so the site runs correctly with this file left exactly as-is.

# --- Django ---------------------------------------------------------------
# Leave blank in development; a throwaway key is generated automatically.
# Required in production.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- IPFS pinning (Pinata) ------------------------------------------------
# Without these, listings still publish; the IPFS step is skipped and the
# listing is marked as "pinning unavailable" instead of failing.
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_BASE_URL=https://api.pinata.cloud/pinning

# --- Language model -------------------------------------------------------
# Optional. Every AI feature has a deterministic local implementation that
# runs with no key at all, so leaving this as "none" is fully supported.
#
#   none        deterministic engine only (default)
#   groq        https://console.groq.com   free: 30 req/min, 1000 req/day
#   gemini      https://aistudio.google.com free tier
#   openrouter  https://openrouter.ai      free: 50 req/day on :free models
#   ollama      http://localhost:11434     local, offline, unlimited
LLM_PROVIDER=none

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Shared limits for whichever provider is selected.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=900

# --- Chain (optional) -----------------------------------------------------
# Leave blank and every property is recorded in a local registry that the
# interface labels "Off chain". Fill these in and the same record is written
# to a testnet instead. Nothing else in the site changes.
#
# Polygon Amoy is the default because its faucet is generous and blocks settle
# in a few seconds. Sepolia works with WEB3_CHAIN_ID=11155111.
#
#   1. RPC URL:  https://polygon-amoy-bor-rpc.publicnode.com  (no signup)
#   2. Key:      a throwaway account made for this, never one holding real funds
#   3. Test POL: https://faucet.polygon.technology
#   4. Deploy:   python manage.py deploy_contracts
#                then paste the two addresses it prints below
WEB3_RPC_URL=
WEB3_PRIVATE_KEY=
WEB3_CHAIN_ID=80002
DEED_CONTRACT_ADDRESS=
SHARES_CONTRACT_ADDRESS=

# --- Deployment (optional) ------------------------------------------------
# Unset, the site uses SQLite and the local filesystem, which is right for
# development and impossible on a host without a writable disk.
#
# DATABASE_URL     any Postgres URL. Neon and Supabase both have a free tier.
# CLOUDINARY_URL   where uploaded photographs go. Without it, uploads have
#                  nowhere to land on a serverless host.
#
# On Vercel these go in the project's environment variables rather than here,
# along with SECRET_KEY. ALLOWED_HOSTS is filled in automatically from the
# deployment's own hostname.
DATABASE_URL=
CLOUDINARY_URL=
